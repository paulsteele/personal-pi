{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptsteele.local/pi-permission-system/permissions.schema.json",
  "title": "Local Pi permission-system configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["permission", "auto"],
  "properties": {
    "permission": {
      "description": "Operator-global policy. Values are allow, ask, deny, or a surface rule map; deny objects may provide a bounded reason.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "enum": ["allow", "ask", "deny"] },
          {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "enum": ["allow", "ask", "deny"] },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action"],
                  "properties": {
                    "action": { "const": "deny" },
                    "reason": { "type": "string", "maxLength": 500 }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "auto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Classifier provider selected by /auto-model."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Classifier model selected by /auto-model."
        },
        "enabledByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Persisted /auto state."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000,
          "default": 20000,
          "description": "Model deadline; expiry safely defers to human or headless denial."
        },
        "contextUserTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3,
          "description": "Bounded untrusted user-turn context."
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trustedRoots": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 },
              "default": []
            },
            "trustedRemotes": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 },
              "default": []
            },
            "trustedDomains": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 },
              "default": []
            }
          },
          "default": { "trustedRoots": [], "trustedRemotes": [], "trustedDomains": [] },
          "description": "Classifier-only trust hints; they never override a guard or policy deny."
        }
      }
    }
  }
}
