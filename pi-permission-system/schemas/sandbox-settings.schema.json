{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandatory devcontainer sandbox settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "permission": { "type": "object" },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelAssistedSetup": {
          "type": "boolean",
          "deprecated": true,
          "description": "Retired setting accepted for compatibility and omitted on save. Built-in model configuration generation has been removed."
        },
        "hostEnvironment": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "default": []
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "default": 120000
        },
        "buildTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 7200000,
          "default": 1800000
        }
      }
    }
  }
}
