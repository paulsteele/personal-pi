{
  "name": "@paulsteele/pi-permission-system",
  "version": "1.0.2",
  "private": true,
  "description": "Personal source-owned Pi permission and auto-mode fork",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "permissions",
    "auto-mode"
  ],
  "files": [
    "src",
    "README.md",
    "FORK.md",
    "CHANGELOG.md",
    "LICENSE",
    "schemas/permissions.schema.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:pack": "node scripts/verify-pack.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:pack"
  },
  "dependencies": {
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.12",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.x",
    "@earendil-works/pi-coding-agent": "0.84.x",
    "@earendil-works/pi-tui": "0.84.x",
    "typebox": "1.3.x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulsteele/personal-pi.git",
    "directory": "pi-permission-system"
  },
  "bugs": {
    "url": "https://github.com/paulsteele/personal-pi/issues"
  },
  "homepage": "https://github.com/paulsteele/personal-pi/tree/main/pi-permission-system"
}
