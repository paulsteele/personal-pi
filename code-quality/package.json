{
	"name": "@paulsteele/pi-code-quality",
	"version": "2.8.1",
	"private": true,
	"description": "Isolated post-edit quality gate with human arbitration",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"quality"
	],
	"files": [
		"*.ts",
		"lsp-broker-host.mjs",
		"lsp-process-guard.mjs",
		"lsp-sandbox-discovery.py",
		"dry-worker.mjs",
		"dry-mcp.mjs",
		"dry-corpus.mjs",
		"dry-corpus.d.mts",
		"dry-suspects.mjs",
		"dry-suspects.d.mts",
		"dry-lexical.mjs",
		"dry-lexical.d.mts",
		"source-disclosure.mjs",
		"source-disclosure.d.mts",
		"dry-policy.md",
		"dry-examples.md",
		"policy.md",
		"examples.md",
		"README.md",
		"lsp-compatibility.md",
		"CHANGELOG.md",
		"!*.test.ts",
		"!test-fixtures.ts",
		"!vitest.config.ts",
		"!calibrate.ts",
		"!dry-calibrate.ts",
		"!dry-scenarios.ts",
		"!lsp-probe.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest run",
		"test:lsp-tui": "node lsp-tui-smoke.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:pack": "node verify-pack.mjs",
		"calibrate": "bun calibrate.ts",
		"calibrate:dry": "bun dry-calibrate.ts"
	},
	"dependencies": {
		"@paulsteele/pi-shared-ui": "workspace:*",
		"@paulsteele/pi-project-locations": "workspace:*",
		"chokidar": "4.0.3",
		"jiti": "2.7.0",
		"vscode-languageserver-protocol": "3.18.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@biomejs/biome": "2.5.4",
		"@types/node": "24.12.4",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
