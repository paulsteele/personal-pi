{
	"name": "@paulsteele/pi-atelier",
	"version": "1.0.2",
	"private": true,
	"description": "Personal source-owned Pi Atelier fork",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"tui",
		"status-bar"
	],
	"files": [
		"extensions",
		"src",
		"README.md",
		"CHANGELOG.md",
		"FORK.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/paulsteele/personal-pi.git",
		"directory": "pi-atelier"
	},
	"bugs": {
		"url": "https://github.com/paulsteele/personal-pi/issues"
	},
	"homepage": "https://github.com/paulsteele/personal-pi/tree/main/pi-atelier",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:pack": "node scripts/verify-pack.mjs",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:pack"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.7",
		"@earendil-works/pi-tui": ">=0.80.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
