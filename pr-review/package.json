{
	"name": "@paulsteele/pi-pr-review",
	"version": "1.2.0",
	"private": true,
	"description": "Code-owned PR reviews with versioned methodology and private repository context",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"review"
	],
	"files": [
		"*.ts",
		"*.mjs",
		"prompts",
		"README.md",
		"CHANGELOG.md",
		"!*.test.*",
		"!test-fixtures.ts",
		"!compatibility*.mjs",
		"!vitest.config.ts",
		"!verify-pack.mjs",
		"!manual-smoke.mjs",
		"!run-tool.mjs"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "node run-tool.mjs vitest run",
		"test:compat": "node --test compatibility.test.mjs",
		"test:browser": "node manual-smoke.mjs",
		"typecheck": "node run-tool.mjs tsc --noEmit",
		"lint": "node run-tool.mjs biome lint .",
		"format": "node run-tool.mjs biome format --write .",
		"format:check": "node run-tool.mjs biome format .",
		"check:pack": "node verify-pack.mjs",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:pack"
	},
	"dependencies": {
		"diff": "8.0.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "0.84.x || 0.85.x",
		"@earendil-works/pi-ai": "0.84.x || 0.85.x",
		"@earendil-works/pi-coding-agent": "0.84.x || 0.85.x",
		"@earendil-works/pi-tui": "0.84.x || 0.85.x",
		"typebox": "1.3.x"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@earendil-works/pi-agent-core": "0.84.3",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.3",
		"@types/node": "24.12.4",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/paulsteele/personal-pi.git",
		"directory": "pr-review"
	}
}
