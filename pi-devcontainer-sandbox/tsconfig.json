{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": { "#src/*": ["./src/*"], "#test/*": ["./test/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
