{
  "name": "@paulsteele/pi-shared-ui",
  "version": "2.9.1",
  "private": true,
  "description": "Shared framed overlays and user-owned settings flows",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./storage": "./storage.ts"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:pack": "node verify-pack.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
